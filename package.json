{
  "name": "jodit-connector-application-nodejs",
  "version": "1.0.0",
  "description": "Jodit FileBrowser and Uploader connector for Node.js",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/run.js",
    "dev": "nodemon --exec ts-node src/run.ts",
    "build": "npm run clean && tsc",
    "clean": "rm -rf dist",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/ && tsc --noEmit",
    "lint:fix": "eslint src/ --fix",
    "docker:build": "docker build -t jodit-connector-nodejs .",
    "docker:run": "docker run --rm -p 3000:3000 jodit-connector-nodejs",
    "docs:generate": "ts-node scripts/generate-openapi.ts"
  },
  "keywords": [
    "jodit",
    "file-manager",
    "uploader"
  ],
  "author": "Chupurnov Valeriy <chupurnov@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "express": "^5.1.0",
    "express-async-handler": "^1.2.0",
    "multer": "^2.0.2",
    "winston": "^3.18.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^8.1.0",
    "@eslint/js": "^9.37.0",
    "@types/express": "^5.0.3",
    "@types/hapi__boom": "^7.4.1",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.7.0",
    "@types/supertest": "^6.0.3",
    "@types/winston": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "eslint": "^9.37.0",
    "globals": "^16.4.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "swagger-ui-dist": "^5.29.3",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "yaml": "^2.8.1"
  }
}
